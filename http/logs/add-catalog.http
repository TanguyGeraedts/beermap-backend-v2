### =====================================================
### Variables
### =====================================================

@keycloak_base=http://localhost:8081
@realm=beermap-v2
@client_id=beermap-backend-v2

@backend_base=http://localhost:8080

@username=tanguy@test.com
@password=test

@catalog_id=
### =====================================================
### Login to Keycloak (Password Grant - DEV ONLY)
### =====================================================

POST {{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&
grant_type=password&
username={{username}}&
password={{password}}

> {%
    client.global.set("access_token", response.body.access_token);
%}

### =====================================================
### POST /api/v1/catalog/drinks
### - Adds a new drink to the global catalog
### =====================================================

POST {{backend_base}}/api/v1/catalog/drinks
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Duvel",
  "category": "BEER",
  "subType": "Belgian Strong Golden Ale",
  "abvPercent": 8.50
}

> {%
    client.global.set("last_catalog_id", response.body.id);
%}

### =====================================================
### GET /api/v1/catalog/drinks/search
### - Search the catalog by name and category
### =====================================================

GET {{backend_base}}/api/v1/catalog/drinks/search?category=BEER&query=Duvel
Authorization: Bearer {{access_token}}
Accept: application/json


### =====================================================
### GET /api/v1/catalog/drinks/search
### - Search the catalog item by name
### =====================================================

GET {{backend_base}}/api/v1/catalog/drinks/search/name?query=Duvel
Authorization: Bearer {{access_token}}
Accept: application/json

### =====================================================
### PUT /api/v1/catalog/drinks/{id}
### - Update an existing catalog item
### =====================================================

PUT {{backend_base}}/api/v1/catalog/drinks/{{last_catalog_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "name": "Duvel 6.66",
  "category": "BEER",
  "subType": "Belgian Blond",
  "abvPercent": 6.66
}


### =====================================================
### DELETE /api/v1/catalog/drinks/{id}
### - Remove from catalog
### =====================================================

DELETE {{backend_base}}/api/v1/catalog/drinks/{{last_catalog_id}}
Authorization: Bearer {{access_token}}