### =====================================================
### Variables
### =====================================================

@keycloak_base=http://localhost:8081
@realm=beermap-v2
@client_id=beermap-backend-v2

@backend_base=http://localhost:8080

@username=tanguy@test.com
@password=test

@catalog_id=a66d1907-7034-46f0-9794-da0d286ab09e
### =====================================================
### Login to Keycloak (Password Grant - DEV ONLY)
### =====================================================

POST {{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&
grant_type=password&
username={{username}}&
password={{password}}

> {%
    client.global.set("access_token", response.body.access_token);
%}


### =====================================================
### POST /api/v1/drink-logs/me
### - Log a new drink (Catalog Item)
### =====================================================

POST {{backend_base}}/api/v1/drink-logs/me
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "catalogItemId": "{{catalog_id}}",
  "quantity": 1,
  "volumeMl": 330,
  "rating": 8,
  "description": "A very nice catalog beer",
  "latitude": 50.8503,
  "longitude": 4.3517
}


### =====================================================
### POST /api/v1/drink-logs/me
### - Log a new drink (Custom Entry)
### =====================================================

POST {{backend_base}}/api/v1/drink-logs/me
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "customDrinkName": "Local Craft IPA",
  "category": "BEER",
  "subType": "IPA",
  "abvPercent": 6.5,
  "quantity": 1,
  "volumeMl": 500,
  "rating": 9,
  "description": "Found this at a local market",
  "latitude": 51.2194,
  "longitude": 4.4025
}

> {%
    client.global.set("created_log_id", response.body.id);
%}


### =====================================================
### GET /api/v1/drink-logs/me
### - Get current user's timeline (paginated)
### =====================================================

GET {{backend_base}}/api/v1/drink-logs/me?page=0&size=20
Authorization: Bearer {{access_token}}
Accept: application/json


### =====================================================
### GET /api/v1/drink-logs/me/{logId}
### - Get specific drink log entry
### =====================================================

GET {{backend_base}}/api/v1/drink-logs/me/{{created_log_id}}
Authorization: Bearer {{access_token}}
Accept: application/json


### =====================================================
### PATCH /api/v1/drink-logs/me/{logId}
### - Partially update a drink log
### =====================================================

PATCH {{backend_base}}/api/v1/drink-logs/me/{{created_log_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "rating": 10,
  "description": "Actually, it was perfect!"
}


### =====================================================
### DELETE /api/v1/drink-logs/me/{logId}
### - Delete a drink log entry
### =====================================================

DELETE {{backend_base}}/api/v1/drink-logs/me/{{created_log_id}}
Authorization: Bearer {{access_token}}