### =====================================================
### Variables
### =====================================================

@keycloak_base=http://localhost:8081
@realm=beermap-v2
@client_id=beermap-backend-v2

@backend_base=http://localhost:8080

@username=tanguy@test.com
@password=test

@cursor=2026-04-27T20:00:00Z
@limit=20


### =====================================================
### Login to Keycloak (Password Grant - DEV ONLY)
### =====================================================

POST {{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&
grant_type=password&
username={{username}}&
password={{password}}

> {%
    client.global.set("access_token", response.body.access_token);
%}


### =====================================================
### GET /api/v1/feed
### - Fetch first page
### =====================================================

GET {{backend_base}}/api/v1/feed
Authorization: Bearer {{access_token}}
Accept: application/json


### =====================================================
### GET /api/v1/feed?cursor=&limit=
### - Fetch next page
### =====================================================

GET {{backend_base}}/api/v1/feed?cursor={{cursor}}&limit={{limit}}
Authorization: Bearer {{access_token}}
Accept: application/json
