### =====================================================
### Variables
### =====================================================

@keycloak_base=http://localhost:8081
@realm=beermap-v2
@client_id=beermap-backend-v2

@backend_base=http://localhost:8080

@username=tanguy@test.com
@password=test

@friendship_id=2c396d92-eee0-4d22-aad9-7c651ad8811a
### =====================================================
### Login to Keycloak (Password Grant)
### =====================================================

POST {{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&
grant_type=password&
username={{username}}&
password={{password}}

> {%
    client.global.set("access_token", response.body.access_token);
%}

### =====================================================
### Accept Friend Request
### =====================================================

POST {{backend_base}}/api/v1/friendships/accept
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
  "userId": "2c396d92-eee0-4d22-aad9-7c651ad8811a"
}

### =====================================================
### Reject Friend Request
### =====================================================

POST {{backend_base}}/api/v1/friendships/{{friendship_id}}/reject
Authorization: Bearer {{access_token}}

### =====================================================
### Cancel Friend Request
### =====================================================

POST {{backend_base}}/api/v1/friendships/{{friendship_id}}/cancel
Authorization: Bearer {{access_token}}

### =====================================================
### Remove Friend
### =====================================================

POST {{backend_base}}/api/v1/friendships/{{friendship_id}}/remove
Authorization: Bearer {{access_token}}

### =====================================================
### Get Friends List
### =====================================================

GET {{backend_base}}/api/v1/friendships/friends
Authorization: Bearer {{access_token}}

### =====================================================
### Get Pending Friend Requests
### =====================================================

GET {{backend_base}}/api/v1/friendships/requests/received
Authorization: Bearer {{access_token}}