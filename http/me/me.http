### =====================================================
### Variables
### =====================================================

@keycloak_base=http://localhost:8081
@realm=beermap-v2
@client_id=beermap-backend-v2

@backend_base=http://localhost:8080

@username=tanguy@test.com
@password=test


### =====================================================
### Login to Keycloak (Password Grant - DEV ONLY)
### =====================================================

POST {{keycloak_base}}/realms/{{realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&
grant_type=password&
username={{username}}&
password={{password}}

> {%
    client.global.set("access_token", response.body.access_token);
%}


### =====================================================
### GET /api/v1/users/me
### - Checks if user exists
### - Returns MeResponse if it does
### - Returns PROFILE_NOT_FOUND if it doesnt
### =====================================================

GET {{backend_base}}/api/v1/users/me
Authorization: Bearer {{access_token}}
Accept: application/json


### =====================================================
### POST /api/v1/users/me
### - Creates user
### - Returns MeResponse
### =====================================================

POST {{backend_base}}/api/v1/users/me
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "username": "Tanguy",
  "bio": "Beer enthusiast",
  "avatarUrl": "https://example.com/avatar.png"
}

### =====================================================
### PATCH /api/v1/users/me
### - Update profile
### =====================================================

PATCH {{backend_base}}/api/v1/users/me
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "username": "Tanguy",
  "bio": "Beer enthusiast",
  "avatarUrl": "https://example.com/avatar.png"
}


### =====================================================
### PATCH /api/v1/users/me
### - Try changing discriminator (should fail if NOT premium)
### =====================================================

PATCH {{backend_base}}/api/v1/users/me
Authorization: Bearer {{access_token}}
Content-Type: application/json
Accept: application/json

{
  "discriminator": "9999"
}